<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TellMe.App.Controls"
             xmlns:tabs="clr-namespace:TellMe.App.Views.Tabs"
             x:Class="TellMe.App.Views.MainPage"
             Title="TellMe"
             BackgroundColor="#FAF7F2">

    <Grid RowDefinitions="Auto, *">

        <!-- ======================================================== -->
        <!-- EN-TÊTE ARTISANALE AVEC LOGO OFFICIEL & OUTILS DÉVELOPPEUR-->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" BackgroundColor="#FFFDF9" Padding="18, 12, 18, 12">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="38"
                            HeightRequest="38"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#E5DFD7"
                            StrokeThickness="1.5"
                            BackgroundColor="#FFFFFF">
                        <Image Source="tellme_mark.png" Aspect="AspectFit" Margin="2" />
                    </Border>
                    <Label Text="TellMe" FontSize="22" FontAttributes="Bold" TextColor="#231F1E" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <!-- Bouton Options / Diagnostics Développeur (Visualiseur de connexions) -->
                    <Border WidthRequest="38"
                            HeightRequest="38"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#231F1E"
                            StrokeThickness="1.5"
                            BackgroundColor="#FFFDF9"
                            VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#231F1E" Offset="1.5, 2" Radius="0" Opacity="0.18" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenDevDiagnosticsClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="icon_settings.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Badge BLE Mesh -->
                    <Border BackgroundColor="#FFFDF9" Stroke="#231F1E" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="10, 5" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#231F1E" Offset="1.5, 2" Radius="0" Opacity="0.18" />
                        </Border.Shadow>
                        <Label Text="BLE MESH" FontSize="11" FontAttributes="Bold" TextColor="#231F1E" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ZONE DES 4 ONGLETS DÉCOUPÉS + BARRE DE NAVIGATION RIVE    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">

            <!-- Onglet 0 : Accueil / Pigeonnier & Roue Rive -->
            <tabs:HomeTabView x:Name="TabHome"
                              IsVisible="True"
                              ShowMyQrRequested="OnShowMyQrClicked"
                              ChangeNameRequested="OnChangeNameClicked"
                              SlotSelected="OnWheelSlotSelected"
                              AddSlotRequested="OnWheelAddSlotClicked"
                              PebbleClicked="OnWheelPebbleClicked"
                              OpenActivePigeonChatRequested="OnOpenActivePigeonChatClicked"
                              RemoveContactFromWheelRequested="OnRemoveContactFromWheelClicked" />

            <!-- Onglet 1 : Discussions Privées Directes -->
            <tabs:ChatsTabView x:Name="TabChats"
                               IsVisible="False"
                               AddContactRequested="OnAddContactClicked"
                               ConversationSelected="OnConversationSelected" />

            <!-- Onglet 2 : Place Publique & Babillard Mesh -->
            <tabs:CampusTabView x:Name="TabCampus"
                                IsVisible="False"
                                OpenCampusBoardRequested="OnOpenCampusBoardClicked" />

            <!-- Onglet 3 : Garde-Robe du Pigeon -->
            <tabs:WardrobeTabView x:Name="TabWardrobe"
                                  IsVisible="False" />

            <!-- Barre de navigation Rive interactive -->
            <controls:RiveBottomBar x:Name="BottomNavBar"
                                    HeightRequest="165"
                                    VerticalOptions="End"
                                    BackgroundColor="Transparent"
                                    SelectedTab="{Binding SelectedTab, Mode=TwoWay}"
                                    TabChanged="OnBottomBarTabChanged" />

        </Grid>

    </Grid>

</ContentPage>
