<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TellMe.Core.Models;assembly=TellMe.Core"
             xmlns:viewmodels="clr-namespace:TellMe.App.ViewModels"
             x:Class="TellMe.App.Views.Tabs.ChatsTabView"
             x:DataType="viewmodels:MainViewModel">

    <Grid RowDefinitions="Auto, *" Padding="16, 12, 16, 170" RowSpacing="12">
        <!-- En-tête de section -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Discussions Privées" FontSize="20" FontAttributes="Bold" TextColor="#231F1E" VerticalOptions="Center" />
            <Border Grid.Column="1"
                    BackgroundColor="#231F1E"
                    Stroke="#231F1E"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 12"
                    Padding="12, 6"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#231F1E" Offset="1.5, 2" Radius="0" Opacity="0.18" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddContactClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Image Source="icon_camera.svg" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Scanner" FontSize="12" FontAttributes="Bold" TextColor="#FAF7F2" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Liste des discussions -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding PrivateChats}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Margin="20, 60">
                    <Border WidthRequest="72"
                            HeightRequest="72"
                            StrokeShape="RoundRectangle 36"
                            Stroke="#E5DFD7"
                            BackgroundColor="#FFFDF9"
                            HorizontalOptions="Center">
                        <Image Source="icon_chat.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Aucune discussion privée" FontSize="18" FontAttributes="Bold" TextColor="#231F1E" HorizontalOptions="Center" />
                    <Label Text="Scannez le QR Code d'un ami pour ouvrir un canal direct chiffré par pigeon voyageur !"
                           FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" LineHeight="1.3" />
                    <Button Text="Scanner un QR Code"
                            BackgroundColor="#231F1E"
                            TextColor="#FAF7F2"
                            BorderColor="#231F1E"
                            BorderWidth="1.5"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="48"
                            Margin="0, 10, 0, 0"
                            Clicked="OnAddContactClicked">
                        <Button.Shadow>
                            <Shadow Brush="#231F1E" Offset="2, 3" Radius="0" Opacity="0.2" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Contact">
                    <Border BackgroundColor="#FFFDF9" Stroke="#E5DFD7" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="14" Margin="0, 4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConversationTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <!-- Badge icône vectorielle -->
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="#FAF7F2" Stroke="#E5DFD7" StrokeThickness="1" VerticalOptions="Center">
                                <Image Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" TextColor="#231F1E" />
                                <Label Text="{Binding ShortId}" FontSize="11" TextColor="#64748B" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Image Grid.Column="2" Source="icon_chevron.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
