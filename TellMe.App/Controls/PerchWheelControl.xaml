<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TellMe.App.Controls.PerchWheelControl"
             WidthRequest="340"
             HeightRequest="340"
             HorizontalOptions="Center"
             VerticalOptions="Center">

    <Grid WidthRequest="340"
          HeightRequest="340"
          HorizontalOptions="Center"
          VerticalOptions="Center">

        <!-- 1. Anneau d'orbite crayonné (fil guide circulaire estompé) -->
        <Ellipse WidthRequest="250"
                 HeightRequest="250"
                 Stroke="#E5DFD7"
                 StrokeThickness="2"
                 StrokeDashArray="4, 4"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"
                 InputTransparent="True" />

        <!-- 2. Zone des perchoirs radiaux (positionnés dynamiquement au millimètre) -->
        <AbsoluteLayout x:Name="SlotsContainer"
                        WidthRequest="340"
                        HeightRequest="340"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

        <!-- 3. Nichoir / Galet central avec le pigeon sur sa balançoire -->
        <Border x:Name="CenterPigeonBorder"
                WidthRequest="136"
                HeightRequest="136"
                StrokeShape="RoundRectangle 68"
                Stroke="#231F1E"
                StrokeThickness="2"
                BackgroundColor="#FFFFFF"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Brush="#231F1E" Offset="2, 4" Radius="0" Opacity="0.18" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCenterPigeonTapped" />
            </Border.GestureRecognizers>

            <Grid>
                <!-- Image du pigeon niché sur son perchoir en bois -->
                <Image Source="pigeon_perch.jpg"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />

                <!-- Anneau intérieur artisanal -->
                <Border StrokeShape="RoundRectangle 66"
                        Stroke="#DDD6FE"
                        StrokeThickness="1.5"
                        BackgroundColor="Transparent"
                        InputTransparent="True" />
            </Grid>
        </Border>

        <!-- 4. Badge d'état au bas du perchoir central -->
        <Border x:Name="StatusBadgeBorder"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                TranslationY="62"
                StrokeShape="RoundRectangle 12"
                Stroke="#231F1E"
                StrokeThickness="1.5"
                Padding="10, 4"
                BackgroundColor="#15803D"
                InputTransparent="True">
            <Border.Shadow>
                <Shadow Brush="#231F1E" Offset="1, 2" Radius="0" Opacity="0.18" />
            </Border.Shadow>
            <Label x:Name="StatusBadgeLabel"
                   Text="AU PERCHOIR"
                   FontSize="10"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />
        </Border>

    </Grid>

</ContentView>
