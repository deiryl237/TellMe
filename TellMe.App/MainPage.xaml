<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TellMe.App.MainPage"
             BackgroundColor="#121214">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- En-tête -->
            <Label Text="🕊️ TellMe - Spike Transport"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   HorizontalOptions="Center" />

            <Label Text="Test Bluetooth RFCOMM P2P (Mode Avion)"
                   FontSize="14"
                   TextColor="#8E8E93"
                   HorizontalOptions="Center" />

            <!-- Indicateur de Statut -->
            <Frame BackgroundColor="#1E1E24" BorderColor="#2E2E38" CornerRadius="12" Padding="14">
                <Label x:Name="StatusLabel"
                       Text="Statut : Prêt (Appairage requis)"
                       FontSize="14"
                       TextColor="#30D158"
                       HorizontalOptions="Center" />
            </Frame>

            <BoxView HeightRequest="1" Color="#2E2E38" Margin="0,4" />

            <!-- RÔLE 1 : TÉLÉPHONE RÉCEPTEUR -->
            <Label Text="Option A : Être le Récepteur (Attendre)"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />

            <Button x:Name="ListenBtn"
                    Text=" Se mettre en écoute"
                    BackgroundColor="#0A84FF"
                    TextColor="#FFFFFF"
                    CornerRadius="8"
                    Clicked="OnListenClicked" />

            <BoxView HeightRequest="1" Color="#2E2E38" Margin="0,4" />

            <!-- RÔLE 2 : TÉLÉPHONE ÉMETTEUR -->
            <Label Text="Option B : Être l'Émetteur (Se connecter)"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />

            <Button x:Name="RefreshDevicesBtn"
                    Text="🔄 Lister les appareils appairés"
                    BackgroundColor="#3A3A3C"
                    TextColor="#FFFFFF"
                    CornerRadius="8"
                    Clicked="OnRefreshDevicesClicked" />

            <Picker x:Name="DevicesPicker"
                    Title="Choisir le téléphone ami"
                    TitleColor="#8E8E93"
                    TextColor="#FFFFFF"
                    BackgroundColor="#1E1E24" />

            <Button x:Name="ConnectBtn"
                    Text=" Se connecter à ce téléphone"
                    BackgroundColor="#30D158"
                    TextColor="#FFFFFF"
                    CornerRadius="8"
                    Clicked="OnConnectClicked" />
                <Button x:Name="DisconnectBtn"
                    Text="🔌 Déconnecter le pigeon actuel"
                    BackgroundColor="#FF453A"
                    TextColor="#FFFFFF"
                    CornerRadius="8"
                    Clicked="OnDisconnectClicked" />

            <BoxView HeightRequest="1" Color="#2E2E38" Margin="0,4" />

            <!-- ZONE D'ENVOI -->
            <Label Text="Échange de message"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />

            <Entry x:Name="AuthorEntry"
                Placeholder="Mon pseudo (ex: Téléphone 1)"
                Text="Téléphone 1"
                PlaceholderColor="#8E8E93"
                TextColor="#FFFFFF"
                BackgroundColor="#1E1E24" />


            <Entry x:Name="MessageEntry"
                   Placeholder="Écris ton message secret ici..."
                   PlaceholderColor="#8E8E93"
                   TextColor="#FFFFFF"
                   BackgroundColor="#1E1E24" />

            <Button x:Name="SendBtn"
                    Text=" Envoyer le pigeon !"
                    BackgroundColor="#BF5AF2"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnSendClicked" />
            <Button x:Name="SyncBtn"
                    Text=" Synchroniser le DAG"
                    BackgroundColor="#FF9F0A"
                    TextColor="#FFFFFF"
                    CornerRadius="8"
                    Clicked="OnSyncClicked" />

   
            <!-- ZONE DU DAG LOCAL -->
        <Label x:Name="DagStatusLabel"
            Text="DAG : 0 message | 0 tête"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="#30D158"
            Margin="0,8,0,0" />

        <Frame BackgroundColor="#1C1C1E" BorderColor="#3A3A3C" CornerRadius="10" Padding="14">
            <Label x:Name="DagMessagesLabel"
                Text="(Aucun message dans le DAG local)"
                FontSize="14"
                TextColor="#FFD60A" />
        </Frame>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
