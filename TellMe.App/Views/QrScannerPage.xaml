<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="TellMe.App.Views.QrScannerPage"
             Title="Scanner un ami"
             BackgroundColor="#000000">

    <Grid RowDefinitions="*, Auto">
        <!-- Le flux vidéo de la caméra -->
        <zxing:CameraBarcodeReaderView Grid.Row="0"
                                       x:Name="BarcodeReader"
                                       BarcodesDetected="OnBarcodesDetected" />

        <!-- En bas : Consigne et Annulation -->
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="12" BackgroundColor="#121214">
            <Label Text="Pointe l'objectif vers le QR Code TellMe de ton ami."
                   TextColor="#8E8E93"
                   FontSize="13"
                   HorizontalOptions="Center" />

            <Button Text="Annuler"
                    BackgroundColor="#231F1E"
                    TextColor="#FAF7F2"
                    BorderColor="#3D3835"
                    BorderWidth="1.5"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="46"
                    Clicked="OnCancelClicked">
                <Button.Shadow>
                    <Shadow Brush="#000000" Offset="1.5, 2" Radius="0" Opacity="0.3" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
