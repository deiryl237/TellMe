<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TellMe.App.Controls"
             xmlns:viewmodels="clr-namespace:TellMe.App.ViewModels"
             x:Class="TellMe.App.Views.Tabs.HomeTabView"
             x:DataType="viewmodels:MainViewModel">

    <ScrollView Padding="16, 12, 16, 170">
        <VerticalStackLayout Spacing="16">

            <!-- Profil & Statut Pigeon voyageur (Style crayonné / papier chaud) -->
            <Border BackgroundColor="#FFFDF9" Stroke="#E5DFD7" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="14">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <!-- Avatar avec l'emblème TellMe -->
                    <Border Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 24"
                            Stroke="#DDD6FE"
                            StrokeThickness="2"
                            BackgroundColor="#FFFFFF"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowMyQrClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="tellme_mark.png" Aspect="AspectFit" Margin="4" />
                    </Border>

                    <!-- Nom d'utilisateur avec bouton d'édition -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding DisplayName}" FontSize="17" FontAttributes="Bold" TextColor="#231F1E" VerticalOptions="Center" />
                            <Border WidthRequest="28"
                                    HeightRequest="28"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#231F1E"
                                    StrokeThickness="1.5"
                                    BackgroundColor="#FFFDF9"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#231F1E" Offset="1, 1.5" Radius="0" Opacity="0.18" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditNameClicked" />
                                </Border.GestureRecognizers>
                                <Image Source="icon_edit.svg" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding StatusText}" FontSize="12" TextColor="#15803D" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- Bouton Mon QR Code -->
                    <Border Grid.Column="2"
                            BackgroundColor="#FFFDF9"
                            Stroke="#231F1E"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            Padding="12, 6"
                            VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#231F1E" Offset="1.5, 2" Radius="0" Opacity="0.18" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowMyQrClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Image Source="icon_qr.svg" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                            <Label Text="QR" FontSize="12" FontAttributes="Bold" TextColor="#231F1E" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Hero Centerpiece : Médaillon Perchoir Circulaire + Sélecteur Radial d'Escouade Pigeon -->
            <Border BackgroundColor="#FFFDF9" Stroke="#E5DFD7" StrokeThickness="1.5" StrokeShape="RoundRectangle 24" Padding="12">
                <VerticalStackLayout Spacing="14">

                    <!-- Roue native artisanale des perchoirs avec nichoir central animé -->
                    <controls:PerchWheelControl x:Name="PerchWheel"
                                                HeightRequest="340"
                                                WidthRequest="340"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                SlotSelected="OnWheelSlotSelected"
                                                AddSlotClicked="OnWheelAddSlotClicked"
                                                CenterPigeonClicked="OnWheelPebbleClicked" />

                    <!-- Titre & Info du Pigeon Actif -->
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="{Binding ActivePigeonName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#231F1E"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding ActivePigeonSubtitle}"
                               FontSize="13"
                               TextColor="#7C3AED"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Carte Mission & Boutons d'action directe -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="#E5DFD7"
                            StrokeThickness="1"
                            BackgroundColor="#FAF7F2"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding ActivePigeonMissionText}"
                                   FontSize="13"
                                   TextColor="#3D3835"
                                   LineHeight="1.3" />

                            <Button Text="{Binding ActivePigeonActionText}"
                                    BackgroundColor="#231F1E"
                                    TextColor="#FAF7F2"
                                    BorderColor="#231F1E"
                                    BorderWidth="1.5"
                                    FontAttributes="Bold"
                                    CornerRadius="14"
                                    HeightRequest="48"
                                    Clicked="OnOpenActivePigeonChatClicked">
                                <Button.Shadow>
                                    <Shadow Brush="#231F1E" Offset="2, 3" Radius="0" Opacity="0.2" />
                                </Button.Shadow>
                            </Button>

                            <!-- Bouton pour retirer le contact de la roue -->
                            <Button x:Name="RemoveFromWheelButton"
                                    Text="Retirer ce contact de la roue"
                                    BackgroundColor="#FFF5F5"
                                    TextColor="#B91C1C"
                                    BorderColor="#EF4444"
                                    BorderWidth="1.5"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="40"
                                    Clicked="OnRemoveContactFromWheelClicked"
                                    IsVisible="{Binding IsSelectedContactOnWheel}">
                                <Button.Shadow>
                                    <Shadow Brush="#EF4444" Offset="1.5, 2" Radius="0" Opacity="0.15" />
                                </Button.Shadow>
                            </Button>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Présentation Réseau Mesh & Pigeons -->
            <Border BackgroundColor="#FFFDF9" Stroke="#E5DFD7" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0" Source="icon_radar.svg" WidthRequest="22" HeightRequest="22" Margin="0,0,8,0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Réseau Mesh Décentralisé" FontSize="16" FontAttributes="Bold" TextColor="#231F1E" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="TellMe fonctionne à 100% sans Internet ni 4G grâce au maillage Bluetooth . Vos pigeons transportent vos messages de proche en proche !"
                           FontSize="13" TextColor="#64748B" LineHeight="1.3" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0, 4, 0, 0">
                        <Border BackgroundColor="#FAF7F2" Stroke="#E5DFD7" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Protocole" FontSize="11" TextColor="#64748B" />
                                <Label Text="BLE DTN Mesh" FontSize="13" FontAttributes="Bold" TextColor="#15803D" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#FAF7F2" Stroke="#E5DFD7" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Sécurité" FontSize="11" TextColor="#64748B" />
                                <Label Text="ECDSA &amp; AES-256" FontSize="13" FontAttributes="Bold" TextColor="#7C3AED" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
