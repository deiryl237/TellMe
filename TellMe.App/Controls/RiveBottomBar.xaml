<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TellMe.App.Controls"
             x:Class="TellMe.App.Controls.RiveBottomBar"
             HeightRequest="165"
             BackgroundColor="Transparent">

    <Grid HeightRequest="165" BackgroundColor="Transparent">

        <!-- Forme d'arrière-plan beige uni épousant strictement l'arc du fil Rive -->
        <Path x:Name="BeigeArcPath"
              Fill="#F5EFE6"
              StrokeThickness="0"
              InputTransparent="True"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0, 42" IsClosed="True">
                        <LineSegment Point="30, 42" />
                        <BezierSegment Point1="135, 110" Point2="295, 110" Point3="400, 42" />
                        <LineSegment Point="430, 42" />
                        <LineSegment Point="430, 165" />
                        <LineSegment Point="0, 165" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- 1. Vue Rive native animée (arrière-plan interactif 60 FPS) -->
        <controls:RiveBottomBarView x:Name="RiveView"
                                    HeightRequest="165"
                                    BackgroundColor="Transparent"
                                    InputTransparent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

        <!-- 2. Grille tactile invisible à 4 colonnes (Accueil, Chats, Public, Garde-Robe) -->
        <Grid ColumnDefinitions="*, *, *, *"
              HeightRequest="120"
              VerticalOptions="End"
              BackgroundColor="Transparent"
              HorizontalOptions="Fill">

            <!-- Colonne 0 : ACCUEIL -->
            <Grid Grid.Column="0" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab0Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Colonne 1 : CHATS -->
            <Grid Grid.Column="1" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab1Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Colonne 2 : PLACE PUBLIQUE -->
            <Grid Grid.Column="2" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab2Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Colonne 3 : GARDE ROBE -->
            <Grid Grid.Column="3" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab3Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

        </Grid>
    </Grid>

</ContentView>
